#!/bin/sh

set -eux

preload_libasan() {
    cc=$(sed -n "s/^CC='//p" config.status | sed "s/'$//")
    if nm ./snmplib/.libs/libnetsnmp.so ./snmplib/.libs/libnetsnmp.dylib 2>/dev/null | grep -q __asan; then
	libasan_path=""
	for name in libasan.dylib libclang_rt.asan_osx_dynamic.dylib libasan.so; do
	    lib=$(${cc} -print-file-name=$name 2>/dev/null)
	    if [ -f "$lib" ]; then
		libasan_path=$lib
		break
	    fi
	done
	if [ -n "$libasan_path" ] && [ -f "$libasan_path" ]; then
	    case "$(uname)" in
		Darwin)
		    export ASAN_OPTIONS=detect_leaks=0 DYLD_INSERT_LIBRARIES="$libasan_path"
		    ;;
		*)
		    export ASAN_OPTIONS=detect_leaks=0 LD_PRELOAD="$libasan_path"
		    ;;
	    esac
	fi
    fi
}

if killall snmpd; then :; fi
export NOAUTODEPS=1
export LD_LIBRARY_PATH="$PWD/snmplib/.libs:$PWD/agent/.libs:$PWD/agent/helpers/.libs:"
export DYLD_LIBRARY_PATH="$LD_LIBRARY_PATH"
export MIBDIRS="$PWD/mibs"
export MIBS=ALL
export SNMP_PERSISTENT_DIR=/tmp/net-snmp
for dir in "$PWD"/python/build/lib.*; do
    export PYTHONPATH="${dir}"
    break
done
mkdir -p "$SNMP_PERSISTENT_DIR"
snmpd_log="/tmp/snmpd-pytests-$$.log"
rm -f "${snmpd_log}"
agent/snmpd -I-smux -r -f -Lo -Lf "${snmpd_log}" \
	    -c python/netsnmp/tests/snmpd.conf localhost:0 &
snmpd_pid=$!

# Wait for snmpd to start and listen
for i in $(seq 1 30); do
    if grep -q "NET-SNMP version" "$snmpd_log" 2>/dev/null; then
        break
    fi
    sleep 0.1
done

# Extract the allocated port
allocated_port=$(sed -n 's/.*Listening on address .*:\([0-9][0-9]*\)$/\1/p' \
		     "${snmpd_log}" | head -n 1)
if [ -z "$allocated_port" ]; then
    echo "Failed to find allocated port in $snmpd_log"
    cat "$snmpd_log"
    kill $snmpd_pid
    exit 1
fi
export SNMP_SNMPD_PORT="$allocated_port"

PYTHONPROG=$(sed -n 's/^S\["PYTHONPROG"\]="\(.*\)"$/\1/p' config.status)
[ -n "$PYTHONPROG" ]
preload_libasan
$PYTHONPROG -m unittest python/netsnmp/tests/test.py
kill $snmpd_pid
wait
rm -f "$snmpd_log"
