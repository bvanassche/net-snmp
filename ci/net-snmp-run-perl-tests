#!/bin/sh

set -eu

preload_libasan() {
    cc=$(sed -n "s/^CC='//p" config.status | sed "s/'$//")
    if nm ./snmplib/.libs/libnetsnmp.so ./snmplib/.libs/libnetsnmp.dylib 2>/dev/null | grep -q __asan; then
	libasan_path=""
	for name in libasan.dylib libclang_rt.asan_osx_dynamic.dylib libasan.so; do
	    lib=$(${cc} -print-file-name=$name 2>/dev/null)
	    if [ -f "$lib" ]; then
		libasan_path=$lib
		break
	    fi
	done
	if [ -n "$libasan_path" ] && [ -f "$libasan_path" ]; then
	    case "$(uname)" in
		Darwin)
		    export ASAN_OPTIONS=detect_leaks=0 DYLD_INSERT_LIBRARIES="$libasan_path"
		    ;;
		*)
		    export ASAN_OPTIONS=detect_leaks=0 LD_PRELOAD="$libasan_path"
		    ;;
	    esac
	fi
    fi
}

lib_dirs() {
    find . \( -name '*.dylib' -o -name '*.so' \) |
	grep -v NetSNMP/agent/default_store |
	sed 's,^\./,'"$PWD/"',;s,/[^/]*$,,' |
	sort -u |
	tr '\n' :
}

export NOAUTODEPS=1
make -s perlmakefiles
(
    cd perl
    make -s
)
preload_libasan
# DYLD_LIBRARY_PATH and LD_LIBRARY_PATH must be set before "cd perl" happens.
case "$(uname)" in
    Darwin)
        DYLD_LIBRARY_PATH="$(lib_dirs)"
        export DYLD_LIBRARY_PATH
        ;;
    *)
        LD_LIBRARY_PATH="$(lib_dirs)"
        export LD_LIBRARY_PATH
        ;;
esac
cd perl
rc=0
make test || rc=$?

if [ $rc -eq 0 ]; then
    exit 0
fi

echo "Perl tests failed (exit code $rc). Dumping log files..."
find . -name '*.log' -o -name '*.stderr' |
    while read -r logfile; do
	[ -s "$logfile" ] || continue
        echo "======================================================================"
        echo "FILE: $logfile"
        echo "======================================================================"
        cat "$logfile"
        echo "======================================================================"
    done

exit $rc

